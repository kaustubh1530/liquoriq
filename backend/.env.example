# ─── LiquorIQ Backend — Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME="LiquorIQ"
APP_ENV="development"          # development | staging | production
DEBUG=true

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql+asyncpg://postgres:yourpassword@localhost:5432/liquoriq"

# ── JWT Auth ──────────────────────────────────────────────────────────────────
SECRET_KEY="change-me-to-a-long-random-secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=20